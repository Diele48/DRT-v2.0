//@version=5
//=============================================================================
// Diele DRT Suite
//=============================================================================
//
// Version : 2.0.0
// Build   : 001
//
// Framework
//
//=============================================================================

indicator(
     title = "Diele DRT Suite",
     shorttitle = "DRT",
     overlay = true,
     max_lines_count = 500,
     max_labels_count = 500,
     max_boxes_count = 500)

//=============================================================================
// GENERAL
//=============================================================================

groupGeneral = "General"

htf = input.timeframe(
     "60",
     "CRT Timeframe",
     group = groupGeneral)

levelLength = input.int(
     25,
     "Level Length",
     minval = 5,
     maxval = 500,
     group = groupGeneral)

//=============================================================================
// DISPLAY
//=============================================================================

groupDisplay = "Display"

showCRT = input.bool(
     true,
     "Show CRT Levels",
     group = groupDisplay)

showOpen = input.bool(
     true,
     "Show Open",
     group = groupDisplay)

showMid = input.bool(
     true,
     "Show Mid",
     group = groupDisplay)

showLabels = input.bool(
     true,
     "Show Labels",
     group = groupDisplay)

showDashboard = input.bool(
     true,
     "Show Dashboard",
     group = groupDisplay)

//=============================================================================
// STYLE
//=============================================================================

groupStyle = "Style"

lineWidth = input.int(
     2,
     "Line Width",
     minval = 1,
     maxval = 5,
     group = groupStyle)

labelSize = input.string(
     "Small",
     "Label Size",
     options = ["Tiny","Small","Normal"],
     group = groupStyle)

//=============================================================================
// COLORS
//=============================================================================

groupColors = "Colors"

clrHigh = input.color(
     color.lime,
     "CR High",
     group = groupColors)

clrLow = input.color(
     color.red,
     "CR Low",
     group = groupColors)

clrOpen = input.color(
     color.orange,
     "Open",
     group = groupColors)

clrMid = input.color(
     color.aqua,
     "Mid",
     group = groupColors)

clrBull = input.color(
     color.lime,
     "Bullish CRT",
     group = groupColors)

clrBear = input.color(
     color.red,
     "Bearish CRT",
     group = groupColors)

clrNeutral = input.color(
     color.gray,
     "Neutral",
     group = groupColors)

//=============================================================================
// ENUMS
//=============================================================================

enum CRTState
    WaitingC1
    WaitingC2
    Active

enum CRTDirection
    None
    Bullish
    Bearish
    Both

//=============================================================================
// CRT STATE
//=============================================================================

var CRTState crtState = CRTState.WaitingC1
var CRTDirection crtDirection = CRTDirection.None

//=============================================================================
// REFERENCE CANDLE (C1)
//=============================================================================

var float c1Open = na
var float c1High = na
var float c1Low = na
var float c1Close = na

var int c1HighBar = na
var int c1LowBar = na

//=============================================================================
// VALIDATION CANDLE (C2)
//=============================================================================

var float c2Open = na
var float c2High = na
var float c2Low = na
var float c2Close = na

//=============================================================================
// ACTIVE CRT
//=============================================================================

var float crHigh = na
var float crLow = na
var float crOpen = na
var float crMid = na

var int crHighBar = na
var int crLowBar = na

//=============================================================================
// VALIDATION FLAGS
//=============================================================================

var bool bullSweep = false
var bool bearSweep = false
var bool closeInside = false

//=============================================================================
// HTF CACHE
//=============================================================================

var float htfOpen = na
var float htfHigh = na
var float htfLow = na
var float htfClose = na

//=============================================================================
// DRAWING OBJECTS
//=============================================================================

var line lineHigh = na
var line lineLow = na
var line lineOpen = na
var line lineMid = na

var label lblHigh = na
var label lblLow = na
var label lblOpen = na
var label lblMid = na

//=============================================================================
// DASHBOARD
//=============================================================================

var table dashboard = na

//=============================================================================
// RUNTIME
//=============================================================================

var bool newHTFBar = false

//=============================================================================
// HELPER FUNCTIONS
//=============================================================================

//-----------------------------------------------------------------------------
// Mid Price
//-----------------------------------------------------------------------------

f_mid(_high, _low) =>
    (_high + _low) * 0.5

//-----------------------------------------------------------------------------
// Bull Sweep
//-----------------------------------------------------------------------------

f_isBullSweep(_c1Low, _c2Low) =>
    _c2Low < _c1Low

//-----------------------------------------------------------------------------
// Bear Sweep
//-----------------------------------------------------------------------------

f_isBearSweep(_c1High, _c2High) =>
    _c2High > _c1High

//-----------------------------------------------------------------------------
// Close Inside
//-----------------------------------------------------------------------------

f_isCloseInside(_close, _high, _low) =>
    _close <= _high and _close >= _low

//-----------------------------------------------------------------------------
// Current HTF OHLC
//-----------------------------------------------------------------------------

f_htfOpen() =>
    request.security(syminfo.tickerid, htf, open)

f_htfHigh() =>
    request.security(syminfo.tickerid, htf, high)

f_htfLow() =>
    request.security(syminfo.tickerid, htf, low)

f_htfClose() =>
    request.security(syminfo.tickerid, htf, close)

//-----------------------------------------------------------------------------
// Previous Closed HTF OHLC
//-----------------------------------------------------------------------------

f_prevOpen() =>
    request.security(syminfo.tickerid, htf, open[1])

f_prevHigh() =>
    request.security(syminfo.tickerid, htf, high[1])

f_prevLow() =>
    request.security(syminfo.tickerid, htf, low[1])

f_prevClose() =>
    request.security(syminfo.tickerid, htf, close[1])

//-----------------------------------------------------------------------------
// Label Size
//-----------------------------------------------------------------------------

f_labelSize() =>
    labelSize == "Tiny" ? size.tiny :
     labelSize == "Normal" ? size.normal :
     size.small
//=============================================================================
// RUNTIME
//=============================================================================

// Detect start of a new Higher Timeframe candle
newHTFBar := ta.change(time(htf))

// Cache current Higher Timeframe values
htfOpen := f_htfOpen()
htfHigh := f_htfHigh()
htfLow := f_htfLow()
htfClose := f_htfClose()

//=============================================================================
// CRT ENGINE
//=============================================================================


    
    //-----------------------------------------------------------------------------
// CRT STATE MACHINE
//-----------------------------------------------------------------------------

if newHTFBar

    switch crtState

        //---------------------------------------------------------------------
        // WAITING FOR C1
        //---------------------------------------------------------------------

        CRTState.WaitingC1 =>

            crtState := CRTState.WaitingC2

        //---------------------------------------------------------------------
        // WAITING FOR C2
        //---------------------------------------------------------------------

        CRTState.WaitingC2 =>

            c2Open := f_prevOpen()
            c2High := f_prevHigh()
            c2Low := f_prevLow()
            c2Close := f_prevClose()

            bullSweep := f_isBullSweep(c1Low, c2Low)
            bearSweep := f_isBearSweep(c1High, c2High)

            closeInside := f_isCloseInside(c2Close, c1High, c1Low)

            if closeInside
                crtState := CRTState.Active
            else
                crtState := CRTState.WaitingC1

        //-----------------------------------------------------------------------------
// CRT ACTIVATION
//-----------------------------------------------------------------------------

if newHTFBar and crtState == CRTState.Active

    // Activate CRT Levels
    crHigh := c1High
    crLow := c1Low
    crOpen := c1Open
    crMid := f_mid(crHigh, crLow)

    // Temporary anchors
    crHighBar := c1HighBar
    crLowBar := c1LowBar

    // Determine CRT Direction
    if bullSweep and bearSweep
        crtDirection := CRTDirection.Both
    else if bullSweep
        crtDirection := CRTDirection.Bullish
    else if bearSweep
        crtDirection := CRTDirection.Bearish
    else
        crtDirection := CRTDirection.None

    //-----------------------------------------------------------------------------
// CRT RESET ENGINE
//-----------------------------------------------------------------------------

if newHTFBar and crtState == CRTState.Active

    htfClose := f_prevClose()

    bool resetCRT = htfClose > crHigh or htfClose < crLow

    if resetCRT

        // Reset active CRT
        crHigh := na
        crLow := na
        crOpen := na
        crMid := na

        crHighBar := na
        crLowBar := na

        bullSweep := false
        bearSweep := false
        closeInside := false

        crtDirection := CRTDirection.None

        // Start looking for a new CRT
        crtState := CRTState.WaitingC1

    //-----------------------------------------------------------------------------
// CRT ENGINE FINAL
//-----------------------------------------------------------------------------

if newHTFBar

    // When the previous CRT has been reset,
    // immediately use the last closed HTF candle
    // as the next Reference Candle (C1).

    if crtState == CRTState.WaitingC1

        c1Open := f_prevOpen()
        c1High := f_prevHigh()
        c1Low := f_prevLow()
        c1Close := f_prevClose()

        c1HighBar := bar_index
        c1LowBar := bar_index

        bullSweep := false
        bearSweep := false
        closeInside := false

        crtDirection := CRTDirection.None

        crtState := CRTState.WaitingC2

//=============================================================================
// DRAWING HELPERS
//=============================================================================

f_drawLine(_line, _x1, _price, _color) =>

    int x2 = _x1 + levelLength

    if na(_line)

        line.new(
             x1 = _x1,
             y1 = _price,
             x2 = x2,
             y2 = _price,
             color = _color,
             width = lineWidth)

    else

        line.set_xy1(_line, _x1, _price)
        line.set_xy2(_line, x2, _price)

        line.set_color(_line, _color)
        line.set_width(_line, lineWidth)

        _line



f_drawLabel(_label, _x, _price, _text, _color) =>

    if na(_label)

        label.new(
             x = _x,
             y = _price,
             text = _text,
             style = label.style_none,
             textcolor = _color,
             size = f_labelSize())

    else

        label.set_xy(_label, _x, _price)

        label.set_text(_label, _text)

        label.set_textcolor(_label, _color)

        _label

//=============================================================================
// DRAWING ENGINE
//=============================================================================

if showCRT

    //---------------------------------------------------------------------
    // CR HIGH
    //---------------------------------------------------------------------

    if crtState == CRTState.Active and not na(crHigh)

        lineHigh := f_drawLine(
             lineHigh,
             crHighBar,
             crHigh,
             clrHigh)

        if showLabels

            lblHigh := f_drawLabel(
                 lblHigh,
                 crHighBar + levelLength,
                 crHigh,
                 "CR High",
                 clrHigh)

        else

            if not na(lblHigh)

                label.delete(lblHigh)
                lblHigh := na

    else

        if not na(lineHigh)

            line.delete(lineHigh)
            lineHigh := na

        if not na(lblHigh)

            label.delete(lblHigh)
            lblHigh := na

    //---------------------------------------------------------------------
    // CR LOW
    //---------------------------------------------------------------------

    if crtState == CRTState.Active and not na(crLow)

        lineLow := f_drawLine(
             lineLow,
             crLowBar,
             crLow,
             clrLow)

        if showLabels

            lblLow := f_drawLabel(
                 lblLow,
                 crLowBar + levelLength,
                 crLow,
                 "CR Low",
                 clrLow)

        else

            if not na(lblLow)

                label.delete(lblLow)
                lblLow := na

    else

        if not na(lineLow)

            line.delete(lineLow)
            lineLow := na

        if not na(lblLow)

            label.delete(lblLow)
            lblLow := na
    //---------------------------------------------------------------------
    // CR OPEN
    //---------------------------------------------------------------------

    if showOpen and crtState == CRTState.Active and not na(crOpen)

        lineOpen := f_drawLine(
             lineOpen,
             crHighBar,
             crOpen,
             clrOpen)

        if showLabels

            lblOpen := f_drawLabel(
                 lblOpen,
                 crHighBar + levelLength,
                 crOpen,
                 "Open",
                 clrOpen)

        else

            if not na(lblOpen)

                label.delete(lblOpen)
                lblOpen := na

    else

        if not na(lineOpen)

            line.delete(lineOpen)
            lineOpen := na

        if not na(lblOpen)

            label.delete(lblOpen)
            lblOpen := na
    //---------------------------------------------------------------------
    // CR MID
    //---------------------------------------------------------------------

    if showMid and crtState == CRTState.Active and not na(crMid)

        lineMid := f_drawLine(
             lineMid,
             crHighBar,
             crMid,
             clrMid)

        if showLabels

            lblMid := f_drawLabel(
                 lblMid,
                 crHighBar + levelLength,
                 crMid,
                 "Mid",
                 clrMid)

        else

            if not na(lblMid)

                label.delete(lblMid)
                lblMid := na

    else

        if not na(lineMid)

            line.delete(lineMid)
            lineMid := na

        if not na(lblMid)

            label.delete(lblMid)
            lblMid := na

else

    if not na(lineHigh)

        line.delete(lineHigh)
        lineHigh := na

    if not na(lineLow)

        line.delete(lineLow)
        lineLow := na

    if not na(lineOpen)

        line.delete(lineOpen)
        lineOpen := na

    if not na(lineMid)

        line.delete(lineMid)
        lineMid := na

    if not na(lblHigh)

        label.delete(lblHigh)
        lblHigh := na

    if not na(lblLow)

        label.delete(lblLow)
        lblLow := na

    if not na(lblOpen)

        label.delete(lblOpen)
        lblOpen := na

    if not na(lblMid)

        label.delete(lblMid)
        lblMid := na
//=============================================================================
// PLACEHOLDER
//=============================================================================

// The framework intentionally does not draw anything yet.
// Drawing starts in Module v2.2.0

plot(na, title = "Framework")
